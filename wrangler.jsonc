{
  "name": "marble-race-workshop",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/Items",
      "/GetItem"
    ]
  }
}
